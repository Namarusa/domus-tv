import QmlProject 1.1

Project {
    mainFile: "main.qml"

    QmlFiles {
        directory: "."
    }
    JavaScriptFiles {
        directory: "."
    }
    ImageFiles {
        paths: ["icon.png"]
    }
    Files {
        recursive: true
        filter: "*.ttf"
        directory: "fonts"
    }
    Files {
        filter: "qmldir"
        directory: "qml"
    }
    Files {
        filter: "manifest.json"
        directory: "."
    }
}
